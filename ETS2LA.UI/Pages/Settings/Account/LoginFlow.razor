@page "/settings/account/login"
@using ETS2LA.Networking
@using ETS2LA.Networking.Users
@using ETS2LA.Networking.Settings
@using ETS2LA.UI.Shared.Components
@using ETS2LA.Notifications
@using ETS2LA.Logging
@layout Shared.Layouts.SettingsLayout
@inject NavigationManager Navigation

@code {
    // NOTE: Sanitation is also done on the server side, this is just a client-side check to 
    // provide immediate feedback to the user.

    private const int UsernameMinLength = 3;
    private const int UsernameMaxLength = 32;

    private static readonly System.Text.RegularExpressions.Regex UsernameRegex =
        new(@"^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
            System.Text.RegularExpressions.RegexOptions.Compiled);
    
    private static readonly HashSet<string> ReservedUsernames = new(StringComparer.OrdinalIgnoreCase)
    {
        "admin", "administrator", "root", "system", "support", "moderator", "mod",
        "staff", "official", "ets2la", "anonymous", "null", "undefined", "me", "you",
        "tumppi066", "developer", "dev", "test", "tester", "guest", "user", "account", "login",
        "ets2la-admin", "ets2la-support", "ets2la-moderator",
    };

    private User? CurrentUser => NetworkingSettings.Current.CurrentUser;

    private string Username { get; set; } = string.Empty;
    private string OtpCode { get; set; } = string.Empty;

    private bool LoginMode { get; set; } = true;
    private RegisterResponse? RegisterResponse { get; set; } = null;

    private string? SanitizeUsername()
    {
        // remove whitespace
        Username = System.Text.RegularExpressions.Regex.Replace(Username?.Trim() ?? string.Empty, @"\s+", "");

        if (string.IsNullOrEmpty(Username))
        {
            return _("Please enter a username.");
        }

        if (Username.Length < UsernameMinLength)
        {
            return _("Your username must be at least {0} characters long.", UsernameMinLength);
        }

        if (Username.Length > UsernameMaxLength)
        {
            return _("Your username must be at most {0} characters long.", UsernameMaxLength);
        }

        if (!UsernameRegex.IsMatch(Username))
        {
            return _("Your username may only contain letters, numbers, underscores, hyphens and periods, and must start and end with a letter or number.");
        }

        if (Username.Contains("..") || Username.Contains("__") || Username.Contains("--"))
        {
            return _("Your username may not contain repeated separators.");
        }

        if (ReservedUsernames.Contains(Username))
        {
            return _("The username {0} is reserved. Please choose a different username.", Username);
        }

        return null;
    }

    private void ShowValidationError(string message)
    {
        NotificationHandler.Current.SendNotification(new Notifications.Notification
        {
            Id = Guid.NewGuid().ToString(),
            Title = _("Invalid Input"),
            Content = message,
            Level = NotificationLevel.Warning
        });
    }

    private async Task Login()
    {
        try
        {
            var user = await NetworkingClient.Current.UserClient.Login(Username, OtpCode);
            if (user != null)
            {
                NetworkingSettings.Current.CurrentUser = user;
                NetworkingSettings.Current.Save();
                Logger.Info($"User {user.Username} logged in successfully.");
                NotificationHandler.Current.SendNotification(new Notifications.Notification
                {
                    Id = Guid.NewGuid().ToString(),
                    Title = _("Login Successful"),
                    Content = _("You have successfully logged in as {0}.", user.Username),
                    Level = NotificationLevel.Success
                });
                Navigation.NavigateTo("/settings/account");
            }
            else
            {
                Logger.Warn($"Login failed for user {Username}. Invalid credentials.");
                NotificationHandler.Current.SendNotification(new Notifications.Notification
                {
                    Id = Guid.NewGuid().ToString(),
                    Title = _("Login Failed"),
                    Content = _("Failed to log in. Please check your credentials and try again."),
                    Level = NotificationLevel.Danger
                });
            }
        }
        catch (Exception ex)
        {
            Logger.Error($"An error occurred during login for user {Username}: {ex.Message}");
            NotificationHandler.Current.SendNotification(new Notifications.Notification
            {
                Id = Guid.NewGuid().ToString(),
                Title = _("Login Error"),
                Content = _("An error occurred while trying to log in. Please try again later. Error: ") + ex.Message,
                Level = NotificationLevel.Danger
            });
        }
    }

    private async Task RegisterFlow()
    {
        var usernameError = SanitizeUsername();
        if (usernameError != null)
        {
            ShowValidationError(usernameError);
            return;
        }

        try
        {
            var response = await NetworkingClient.Current.UserClient.Register(Username);
            if (response != null && response.HasValue && string.IsNullOrEmpty(response.Value.error))
            {
                RegisterResponse = response;
                Logger.Info($"User {Username} registered successfully.");
                NotificationHandler.Current.SendNotification(new Notifications.Notification
                {
                    Id = Guid.NewGuid().ToString(),
                    Title = _("Registration Successful"),
                    Content = _("You have successfully registered as {0}. Please add the OTP code to your authentication app.", Username),
                    Level = NotificationLevel.Success
                });
            }
            else if (response != null && response.HasValue && !string.IsNullOrEmpty(response.Value.error))
            {
                if (response.Value.error.Contains("409"))
                {
                    NotificationHandler.Current.SendNotification(new Notifications.Notification
                    {
                        Id = Guid.NewGuid().ToString(),
                        Title = _("Username Taken"),
                        Content = _("The username {0} is already taken. Please choose a different username.", Username),
                        Level = NotificationLevel.Danger
                    });
                    Username = string.Empty;
                    InvokeAsync(StateHasChanged);
                }
                else
                {
                    Logger.Warn($"Registration failed for user {Username} due to {response.Value.error}");
                    NotificationHandler.Current.SendNotification(new Notifications.Notification
                    {
                        Id = Guid.NewGuid().ToString(),
                        Title = _("Registration Failed"),
                        Content = response.Value.error,
                        Level = NotificationLevel.Danger
                    });
                }
            }
        }
        catch (Exception ex)
        {
            Logger.Error($"An error occurred during registration for user {Username}: {ex.Message}");
            NotificationHandler.Current.SendNotification(new Notifications.Notification
            {
                Id = Guid.NewGuid().ToString(),
                Title = _("Registration Error"),
                Content = _("An error occurred while trying to register. Please try again later. Error: ") + ex.Message,
                Level = NotificationLevel.Danger
            });
        }
    }
}

<div class="flex flex-col w-108 p-5 px-8 gap-3">
    @if (LoginMode)
    {
        <Input Title=@_("Username")
                Description=""
                @bind-Value="Username"
                Placeholder=@_("Username")
                Class="w-full" />

        <OTP Title=@_("One Time Password")
                Description=@_("Enter the OTP generated by your authenticator app.")
                @bind-Value="OtpCode"
                Length="6"
                DashIndex="3"
                Class="w-full" />
        
        <button class="button mt-2" @onclick="Login">@(_("Login"))</button>
        <button class="description mt-2 text-start hover:underline cursor-pointer" @onclick="() => LoginMode = false">@((MarkupString)_("Don't have an account?<br/>Register a new one now, no emails required!"))</button>
    }
    else
    {
        if (RegisterResponse != null && RegisterResponse.HasValue)
        {
            <p class="description">@((MarkupString)_("Please add the OTP code to your authentication app.<br/><span class=\"text-text-accent\">Do not close the page before you have added the code. We cannot recover accounts once they are created!</span>"))</p>
            <img class="size-30 rounded-sm mt-2" src="@RegisterResponse.Value.authQrCode" alt="@(_("QR Code for OTP"))" />
            <p class="description mt-2">@RegisterResponse.Value.authUrl</p>
            <button class="button mt-2" @onclick="() => LoginMode = true">@(_("Back to Login"))</button>   
        }
        else
        {
            <p class="description">@(_("You'll be asked to save an OTP authentication code after registration. We do not store or ask for passwords, as those aren't required for authentication."))</p>
            <Input Title=@_("Username")
                    Description=""
                    @bind-Value="Username"
                    Placeholder=@_("Username")
                    Class="w-full" />
            <p class="description">@((MarkupString)_("<span class=\"text-text-accent\">Usernames are case-sensitive.</span><br/>Your username must be between {0} and {1} characters long, and may only contain letters, numbers, underscores, hyphens and periods. It must start and end with a letter or number.", UsernameMinLength, UsernameMaxLength))</p>

            <button class="button mt-2" @onclick="RegisterFlow">@(_("Register"))</button>
            <button class="description mt-2 text-start hover:underline cursor-pointer" @onclick="() => LoginMode = true">@(_("Already have an account? Log in here."))</button>
        }
    }
</div>
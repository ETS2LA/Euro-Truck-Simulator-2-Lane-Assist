@using ETS2LA.State;
@using ETS2LA.Logging;
@using static ETS2LA.Translations.Languages;
@using ETS2LA.UI.Shared.Components;

@code {
    [Parameter]
    public Action OnNext { get; set; }

    [Parameter]
    public Action OnPrevious { get; set; }
}

<div class="flex flex-col gap-2">
    <h3>@((MarkupString)_("Final Disclaimer <span class=\"description\">2/2</span>"))</h3>
    <div class="max-w-108">
        <p>@((MarkupString)_("Additionally, some communities like VTCs, Job Trackers and Leaderboards will ban either specific features, or the entirety of ETS2LA. <span class=\"text-text-accent font-bold\">Please check with your community <i>before</i> using ETS2LA.</span>"))</p>
    </div>

    <div class="flex gap-2 mt-4">
        <button class="button w-full!" @onclick="OnNext">@_("I understand, now let me in!")</button>
    </div>
</div>
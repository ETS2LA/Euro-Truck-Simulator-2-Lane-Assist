@using ETS2LA.State;
@using ETS2LA.Logging;
@using static ETS2LA.Translations.Languages;
@using ETS2LA.UI.Shared.Components;
@using ETS2LA.UI.Pages.Settings;
@using ETS2LA.Controls;

@code {
    [Parameter]
    public Action OnNext { get; set; }

    [Parameter]
    public Action OnPrevious { get; set; }

    private List<string> DisplayOnly { get; set; } = new List<string> { 
        "ETS2LA.Controls.Cancel",
        "ETS2LA.Controls.Increase",
        "ETS2LA.Controls.Decrease"
    };

    protected override void OnInitialized()
    {
        base.OnInitialized();

        ControlsBackend.Current.On("ETS2LA.Controls.Cancel", (object value, ControlChangeEventArgs args) => {
            InvokeAsync(StateHasChanged);
        });
        ControlsBackend.Current.On("ETS2LA.Controls.Increase", (object value, ControlChangeEventArgs args) => {
            InvokeAsync(StateHasChanged);
        });
        ControlsBackend.Current.On("ETS2LA.Controls.Decrease", (object value, ControlChangeEventArgs args) => {
            InvokeAsync(StateHasChanged);
        });
    }
}

<div class="flex gap-12 text-start items-center justify-center">
    <div class="flex flex-col gap-2 max-w-108">
        <div class="flex flex-col gap-1">
            <h3>@((MarkupString)_("Controls"))</h3>
            <p>@((MarkupString)(_("ETS2LA uses a control setup that should be similar to real life systems. You can rebind the default controls on the right side.")))</p>
            <p class="pt-1">@((MarkupString)(_("Assists Enabled: <span class=\"text-text-accent font-bold\">{0}</span>", ApplicationState.Current.EnableAssists)))</p>
            <p>@((MarkupString)(_("Assist Mode: <span class=\"text-text-accent font-bold\">{0}</span>", ApplicationState.Current.DrivingModeTranslation[ApplicationState.Current.DrivingMode])))</p>
            <p>@((MarkupString)(_("Target Speed: <span class=\"text-text-accent font-bold\">{0} {1}</span>", (int)Math.Round(UnitConversions.FromScientificUnits(UnitType.Speed, ApplicationState.Current.DesiredSpeed, ApplicationState.Current.DisplayUnits), 0), UnitConversions.GetUnitAbbreviation(UnitType.Speed, ApplicationState.Current.DisplayUnits))))</p>
        </div>

        <div class="flex gap-2 mt-2">
            <button class="button w-full!" @onclick="OnNext">@_("Continue")</button>
        </div>
        
        <img src="assets/defaultcontrols.png" alt="Control Image" class="max-w-full rounded-md mt-3" />
    </div>

    <div class="max-w-120 max-h-full overflow-y-auto overflow-x-hidden flex flex-col gap-2">
        <Controls DisplayOnly="@DisplayOnly" />
    </div>
</div>
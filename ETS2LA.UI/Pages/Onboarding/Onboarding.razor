@page "/onboarding"
@using ETS2LA.UI.Pages.Onboarding.Steps

@code {
    private bool transitionOut = false;
    private int currentStep;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        currentStep = WindowSettings.Current.OnboardingStep;
        WindowState.Current.IsSidebarOpen = false;
        WindowState.Current.RequestFullReload();
    }

    private void NextStep()
    {
        transitionOut = true;
        Task.Delay(300).ContinueWith(_ => {
            InvokeAsync(() => {
                transitionOut = false;
                currentStep++;
                WindowSettings.Current.OnboardingStep = currentStep;
                WindowSettings.Current.Save();
                StateHasChanged();
            });
        });
    }

    private void PreviousStep() => currentStep--;
}

<div class=@((transitionOut ? "opacity-0" : "opacity-100") + " flex flex-col items-center justify-center w-full h-full relative transition-all duration-200 ease-in-out")>
    @switch (currentStep)
    {
        case 0:
            <WelcomeStep OnNext="NextStep" />
            break;
        case 1:
            <SDKStep OnNext="NextStep" />
            break;
        case 2:
            <SDKReminderStep OnNext="NextStep" />
            break;
        case 3:
            <OverlayStep OnNext="NextStep" />
            break;
        case 4:
            <ControlsStep OnNext="NextStep" />
            break;
        case 5:
            <PluginStep OnNext="NextStep" />
            break;
        case 6:
            <DisclaimerStep1 OnNext="NextStep" />
            break;
        case 7:
            <DisclaimerStep2 OnNext="NextStep" />
            break;
        case 8:
            <FinishStep />
            break;
    }
</div>
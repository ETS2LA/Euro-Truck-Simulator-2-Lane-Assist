@page "/Error/{StatusCode:int}/{Message}"

@code {
    [Parameter]
    public int StatusCode { get; set; } = 404;

    [Parameter]
    public string Message { get; set; } = "Not Found";

    private static readonly Dictionary<int, string> HttpDescriptions = new()
    {
        [400] = _("The server could not understand the request due to invalid syntax or corrupted request data."),
        [401] = _("Authentication is required. The client must authenticate itself to get the requested response."),
        [403] = _("You do not have permission to access this resource. The server understood the request but refuses to authorize it."),
        [404] = _("The server cannot find the requested resource. The URL may be misspelled, or the resource has been removed."),
        [405] = _("The request method is recognized by the server but is not supported by the target resource."),
        [408] = _("The server timed out waiting for the request from the client."),
        [429] = _("Too many requests. You have sent too many requests in a given amount of time."),
        [500] = _("Internal server error. The server encountered an unexpected condition that prevented it from fulfilling the request."),
        [502] = _("Bad gateway. The server, while acting as a gateway or proxy, received an invalid response from an inbound server."),
        [503] = _("Service unavailable. The server is currently unable to handle the request due to temporary overloading or maintenance."),
        [504] = _("Gateway timeout. The server was acting as a gateway or proxy and did not receive a timely response from the upstream server.")
    };

    private string GetHttpDescription(int code)
    {
        return HttpDescriptions.TryGetValue(code, out var description) ? description : string.Empty;
    }
}

<div class="flex flex-col p-6 w-lg">
    @if (Message == "Not Found")
    {
        <img class="rounded-md" src="https://static2.klipy.com/ii/c3a19a0b747a76e98651f2b9a3cca5ff/4d/87/oyStUROc.gif" alt="Kermit is lost, he's looking at a map and around him." />
        <br />
        <p>@(_("You took a wrong turn!"))</p>
        <p class="description">
            @(new HtmlString(_("How did you get here? What were you even thinking?{0}Do tell us in the {1}Discord Server{2} or on {3}GitHub{4}.", 
      "<br />", 
                "<a href=\"https://discord.gg/ets2la\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-text-l hover:underline\">", "</a>", 
                "<a href=\"https://github.com/ETS2LA\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-text-l hover:underline\">", "</a>")))
        </p>
    }
    else
    {
        <img class="rounded-md" src="https://http.cat/@StatusCode" alt="Cat status code @StatusCode" />
        <br />
        <p>@StatusCode - @Message</p>
        <p class="description">
            @GetHttpDescription(StatusCode)<br /><br />
            @(new HtmlString(_("If you think this is a bug, please report it in the {0}Discord Server{1} or on {2}GitHub{3}.", 
                "<a href=\"https://discord.gg/ets2la\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-text-l hover:underline\">", "</a>", 
                "<a href=\"https://github.com/ETS2LA\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-text-l hover:underline\">", "</a>")))
        </p>
    }
</div>
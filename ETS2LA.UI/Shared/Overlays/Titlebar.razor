@inject IJSRuntime JS

@code {
    // This file is slightly cooked, since we have to go through js to make the titlebar draggable.
    // The actual dragging code is in IPC.cs, that gets called from wwwroot/js/titlebar.js which is called from here.

    private ElementReference titlebarRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("initTitlebarDrag", titlebarRef);
        }
    }

    private async Task SendMessage(string msg)
    {
        await JS.InvokeVoidAsync("sendIPCMessage", msg);
    }
}

<style>
    .titlebar {
        -webkit-app-region: drag;
        app-region: drag;
    }

    .titlebar button,
    .titlebar-no-drag {
        -webkit-app-region: no-drag;
        app-region: no-drag;
    }
</style>

<header @ref="titlebarRef" class="titlebar group select-none flex justify-between items-center h-5 absolute right-0 left-40 cursor-grab active:cursor-grabbing z-999">
    <div></div>
    <div class="titlebar-no-drag rounded-bl-md rounded-tr-md border-r border-border group z-1000 flex h-full bg-bg opacity-0 group-hover:opacity-100 transition-opacity p-1 items-center">
        <button @onclick='() => SendMessage("window:minimize")' class="w-5 p-0.5 text-description hover:text-text cursor-pointer">
            <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24"><path fill="currentColor" d="M7 19h10c.55 0 1 .45 1 1s-.45 1-1 1H7c-.55 0-1-.45-1-1s.45-1 1-1"/></svg>
        </button>
        <button @onclick='() => SendMessage("window:maximize")' class="w-5 p-0.5 text-description hover:text-text cursor-pointer">
            <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24"><path fill="currentColor" d="M19 3H5c-1.11 0-2 .89-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2m0 2v14H5V5z"/></svg>
        </button>
        <button @onclick='() => SendMessage("window:close")' class="w-5 p-0.5 text-description hover:text-text cursor-pointer">
            <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24"><path fill="currentColor" d="m12 13.4l-4.9 4.9q-.275.275-.7.275t-.7-.275t-.275-.7t.275-.7l4.9-4.9l-4.9-4.9q-.275-.275-.275-.7t.275-.7t.7-.275t.7.275l4.9 4.9l4.9-4.9q.275-.275.7-.275t.7.275t.275.7t-.275.7L13.4 12l4.9 4.9q.275.275.275.7t-.275.7t-.7.275t-.7-.275z"/></svg>
        </button>
    </div>
</header>
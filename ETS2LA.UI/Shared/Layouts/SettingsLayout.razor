@using ETS2LA.UI.Shared.WindowControls
@using ETS2LA.UI.Shared.Components
@layout Shared.Layouts.MainLayout

@inherits LayoutComponentBase

<main class="flex h-full w-full flex-col bg-bg-dark">
  <div class="flex p-1.5 h-full w-full">
    <!-- Sidebar -->
    <div class="w-[230px] pl-2 pr-3 pt-2 flex gap-6.5 flex-col h-full">
      <div class="flex flex-col gap-0">
        <SidebarGroupLabel Title="Driving" />
        <SidebarButton Name="Assists" Path="/settings/assists" />
        <SidebarButton Name="Data Parsing" Path="/settings/data" />
      </div>

      <div class="flex flex-col gap-0">
        <SidebarGroupLabel Title="General" />
        <SidebarButton Name="Display" Path="/settings/display" />
        <SidebarButton Name="Audio" Path="/settings/audio" />
        <SidebarButton Name="Controls" Path="/settings/controls" />
      </div>

      <div class="flex flex-col gap-0">
        <SidebarGroupLabel Title="Additional" />
        <SidebarButton Name="Game SDK" Path="/settings/sdk" />
        <SidebarButton Name="Experiments" Path="/settings/experiments" />
      </div>

      <div class="flex flex-col gap-0">
        <SidebarGroupLabel Title="Networking" />
        <SidebarButton Name="Account" Path="/settings/account" />
        <SidebarButton Name="Telemetry" Path="/settings/telemetry" />
      </div>

      <div class="flex flex-col w-52 gap-0 bottom-6 absolute">
        <SidebarButton Name="Check For Updates" Path="/settings/updates" />
      </div>
    </div>

    <div class="mt-3 mb-3 bg-control-bg w-0.5 rounded-md"></div>

    <!-- Main Content -->
    <div class="w-full h-full bg-bg-dark rounded-md rounded-l-lg overflow-y-auto">
      @Body      
    </div>
  </div>
</main>
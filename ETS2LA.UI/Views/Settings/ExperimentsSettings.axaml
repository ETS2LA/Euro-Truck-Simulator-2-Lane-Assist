<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ETS2LA.UI.Views.Settings"
             x:Class="ETS2LA.UI.Views.Settings.ExperimentsSettings"
             x:DataType="views:ExperimentsSettings">
    <Grid ColumnDefinitions="450,*">
        <StackPanel Grid.Column="0" Spacing="12" Margin="20">
            <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*, Auto">
                    <TextBlock Text="Render Vision Cameras" VerticalAlignment="Center" />
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding RenderVisionCameras}" Classes="primary-toggle" AutomationProperties.Name="Render Vision Cameras" />
                </Grid>
                <TextBlock Text="Render experimental vision cameras. These can be used by vision based machine learning models for end-to-end self driving. Note that these models don't yet exist, however for development purposes we are leaving the cameras accessible." FontSize="12" Classes="Description" />
                <TextBlock Text="You need to restart ETS2LA for this option to apply." FontSize="12" Classes="Warning" IsVisible="{Binding RenderVisionCamerasRequiresRestart}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
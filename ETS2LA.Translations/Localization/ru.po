msgstr "Не удалось добавить игру"

msgid "Show More Logs"
msgstr "Показать больше логов"

msgid "Warning: Insufficient RAM"
msgstr "Предупреждение: недостаточно оперативной памяти"

msgid "hide"
msgstr "скрыть"


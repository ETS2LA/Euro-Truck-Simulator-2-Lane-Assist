msgstr "Не все зависимости для плагина {0} установлены."

msgid "Adaptive Cruise Control"
msgstr "Адаптивный круиз контроль"

msgid ""
"Authentication is required. The client must authenticate itself to get the "
"requested response."
msgstr ""
"Требуется аутентификация. Клиент должен пройти аутентификацию, чтобы "
"получить запрошенный ответ."

msgid "Units and Language"
msgstr "Единицы измерения и язык"

#, csharp-format
msgid "Unloading parsed map data for installation at '{0}'"
msgstr "Выгрузка обработанных данных карты для установки по пути '{0}'"

msgid "SDKs are currently installed."
msgstr "Пакеты SDK уже установлены."

